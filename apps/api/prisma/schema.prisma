generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
}

enum OrderStatus {
  PENDING_PAYMENT
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CLIENT)
  name         String
  avatar       String?
  phone        String?
  emailVerified Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  providerProfile ProviderProfile?
  wallet          Wallet?
  ordersAsClient  Order[]          @relation("ClientOrders")
  ordersAsProvider Order[]         @relation("ProviderOrders")

  @@index([email])
  @@index([role])
}

model ProviderProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  displayName String
  bio         String?
  skills      String[]
  kycStatus   KYCStatus @default(PENDING)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@index([kycStatus])
}

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  nameAr   String
  active   Boolean @default(true)
  sortOrder Int    @default(0)

  listings Listing[]

  @@index([active, sortOrder])
}

model Listing {
  id           String        @id @default(cuid())
  providerId   String
  categoryId   String
  title        String
  summary      String
  price        Decimal       @db.Decimal(10, 2)
  deliveryDays Int
  samples      String[]
  status       ListingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id])
  orders   Order[]

  @@index([categoryId, status, createdAt])
  @@index([providerId, status])
  @@index([price])
  @@index([status])
}

model Order {
  id           String      @id @default(cuid())
  clientId     String
  providerId   String
  listingId    String
  price        Decimal     @db.Decimal(10, 2)
  platformFee  Decimal     @db.Decimal(10, 2)
  escrowAmount Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING_PAYMENT)
  requirements String?
  deliveryUrl  String?
  deliveryDate DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client       User          @relation("ClientOrders", fields: [clientId], references: [id])
  provider     User          @relation("ProviderOrders", fields: [providerId], references: [id])
  listing      Listing       @relation(fields: [listingId], references: [id])

  @@index([clientId, status])
  @@index([providerId, status])
  @@index([status, createdAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  available Decimal  @default(0) @db.Decimal(10, 2)
  pending   Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("SAR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminSettings {
  id              Int     @id @default(1)
  platformFeePct  Int     @default(10)
  minPayout       Decimal @default(100) @db.Decimal(10, 2)
  currency        String  @default("SAR")
  maintenanceMode Boolean @default(false)
  updatedAt       DateTime @updatedAt
}
