# Database
DATABASE_URL="postgresql://creativehub:dev_password@localhost:5432/creativehub_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_SECRET="dev-jwt-secret-change-in-production-minimum-32-characters-long"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production-minimum-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# SendGrid Email (use mailhog in dev)
SENDGRID_API_KEY="SG.dev-key"
EMAIL_FROM="noreply@creativehub.sa"
EMAIL_FROM_NAME="CreativeHub KSA"

# Google Cloud Storage (mock in dev)
GCS_BUCKET="creativehub-storage-dev"
GCP_PROJECT_ID="creativehub-dev"

# Payment Providers (use test mode)
PAYMENT_PROVIDER="stripetest"

# Stripe Payment (Test Mode)
STRIPE_SECRET_KEY="sk_test_51234567890"
STRIPE_WEBHOOK_SECRET="whsec_test123"
STRIPE_PUBLISHABLE_KEY="pk_test_51234567890"

# Tap Payment (optional)
TAP_SECRET_KEY="sk_test_"
TAP_WEBHOOK_SECRET=""
TAP_BASE_URL="https://api.tap.company/v2"

# Moyasar Payment (optional)
MOYASAR_SECRET_KEY="sk_test_"
MOYASAR_WEBHOOK_SECRET=""
MOYASAR_BASE_URL="https://api.moyasar.com/v1"

# Application URLs
SITE_URL="http://localhost:3000"
API_URL="http://localhost:4000"
WS_URL="ws://localhost:4000"

# App Config
NODE_ENV="development"
PORT=4000
WEB_PORT=3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE_MB=100
